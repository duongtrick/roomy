EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Khoá Maps SDK for Android. Chỉ cần cho bản build native (APK/AAB) — Expo Go
# dùng khoá riêng của nó nên chạy dev vẫn thấy bản đồ dù để trống.
# Không có tiền tố EXPO_PUBLIC_: khoá được đọc lúc build trong app.config.ts,
# không vào bundle JS.
GOOGLE_MAPS_ANDROID_API_KEY=<android-maps-sdk-key>
